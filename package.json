{
  "name": "shadowcrypt",
  "version": "1.2.1",
  "description": "AES-256 file encryption & decryption",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "preview": "electron-vite preview"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.shadowcrypt.app",
    "productName": "Shadow Crypt",
    "executableName": "ShadowCrypt",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": ["out/**"],
    "fileAssociations": [
      {
        "ext": "aes",
        "name": "ShadowCrypt Encrypted File",
        "description": "ShadowCrypt Encrypted File",
        "mimeType": "application/x-shadowcrypt"
      }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "resources/icon.ico"
    },
    "linux": {
      "target": [{ "target": "AppImage", "arch": ["x64"] }],
      "icon": "resources/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    }
  }
}
